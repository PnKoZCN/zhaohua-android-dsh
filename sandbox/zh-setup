#!/bin/sh
# ZhaoHua sandbox toolbox installer — runs INSIDE the Alpine aarch64 rootfs.
#
# Usage (inside the sandbox):
#   zh-setup                  # default: base+build+python+node+binutils+net+re
#                             #          +efficiency+pyre (capstone/pwntools)
#   zh-setup --with-java      # also install a JRE
#   zh-setup --only=gorust    # only the named sections (gorust is opt-in)
#   zh-setup --dry-run        # print the plan, install nothing
#   zh-setup --list           # show sections and their probe commands
#
# Idempotent: a section whose probe command already exists is skipped.
set -u

REPORT=/root/zh-toolbox-report.txt
LOG=/root/zh-setup.log
DRY=0
WITH_JAVA=0
ONLY=""
LIST=0

for a in "$@"; do
  case "$a" in
    --dry-run)   DRY=1 ;;
    --with-java) WITH_JAVA=1 ;;
    --only=*)    ONLY="${a#--only=}" ;;
    --list)      LIST=1 ;;
    *) echo "zh-setup: unknown arg: $a" >&2; exit 64 ;;
  esac
done

if ! command -v apk >/dev/null 2>&1; then
  echo "zh-setup: apk not found — not an Alpine rootfs?" >&2
  exit 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

# name|probe|packages
# Default sections: base build python node binutils net re efficiency pyre
# Opt-in sections:  java gorust
SECTIONS='
base|git|bash git curl wget unzip zip tar gzip xz file jq procps
build|gcc|build-base gcc g++ make cmake ninja pkgconf
python|python3|python3 py3-pip py3-virtualenv
node|node|nodejs npm
binutils|nasm|binutils nasm
net|tcpdump|netcat-openbsd tcpdump bind-tools
re|radare2|radare2 gdb ltrace patchelf
efficiency|htop|htop vim nano less tree diffutils patch rsync openssh-client sqlite openssl-dev
pyre|pip3|python3-dev && pip install --quiet capstone pwntools
gorust|go|go rust cargo
java|java|openjdk21-jre-headless
'

want_section() {
  [ -z "$ONLY" ] || case ",$ONLY," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

if [ "$LIST" = "1" ]; then
  printf '%s\n' "$SECTIONS" | while IFS='|' read -r name probe pkgs; do
    [ -n "$name" ] || continue
    if have "$probe"; then st="installed"; else st="missing"; fi
    printf '%-9s probe=%-10s %-10s %s\n' "$name" "$probe" "$st" "$pkgs"
  done
  exit 0
fi

mkdir -p /root/work /root/share 2>/dev/null
: > "$LOG" 2>/dev/null || true

# DNS for the sandbox (the rootfs has no /etc/resolv.conf of its own)
if [ ! -s /etc/resolv.conf ]; then
  printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf 2>/dev/null || true
fi

echo "== ZhaoHua sandbox toolbox =="
echo "alpine: $(cat /etc/alpine-release 2>/dev/null)  arch: $(uname -m)"
echo "repos:  $(tr '\n' ' ' < /etc/apk/repositories 2>/dev/null)"

# bash is not in the Alpine minirootfs, but the shell router runs
# `bash -c <command>` inside the sandbox — without it every routed command fails.
if ! have bash && [ "$DRY" != "1" ]; then
  echo "[install] bash (required by the shell router)"
  apk add --no-cache bash >>"$LOG" 2>&1 && echo "[ok]     bash" || { echo "[FAIL]   bash"; tail -5 "$LOG"; }
fi

# Alpine marks the system python as externally managed (PEP 668), so a plain
# `pip install x` aborts with externally-managed-environment. This sandbox exists
# for ad-hoc tooling — let it write to the system prefix.
if [ ! -f /etc/pip.conf ]; then
  printf '[global]\nbreak-system-packages = true\n' > /etc/pip.conf 2>/dev/null \
    && echo "[ok]     /etc/pip.conf (PEP 668 bypass for the sandbox)"
fi

DONE=""
SKIP=""
FAIL=""
PIP_FAILED=""

printf '%s\n' "$SECTIONS" | while IFS='|' read -r name probe pkgs; do
  [ -n "$name" ] || continue
  if ! want_section "$name"; then
    echo "[skip]   $name (not selected)"
    continue
  fi
  if [ "$name" = "java" ] && [ "$WITH_JAVA" != "1" ]; then
    echo "[skip]   java (opt-in: zh-setup --with-java)"
    continue
  fi
  if [ "$name" = "gorust" ] && [ -z "$ONLY" ]; then
    echo "[skip]   gorust (opt-in: zh-setup --only=gorust)"
    continue
  fi
  # Section already fully satisfied?
  case "$probe" in
    *"&&"*)
      # compound probe: every command must exist
      ok=1
      for c in $(printf '%s' "$probe" | sed 's/ *&& */\n/g'); do
        have "$c" || ok=0
      done
      ;;
    *) ok=1; have "$probe" || ok=0 ;;
  esac
  if [ "$ok" = "1" ] && [ "$name" != "pyre" ]; then
    echo "[have]   $name"
    continue
  fi
  if [ "$DRY" = "1" ]; then
    echo "[dry]    $name: $pkgs"
    continue
  fi
  # pip-based section (pyre) installs via pip, not apk
  if [ "$name" = "pyre" ]; then
    echo "[install] $name (pip)"
    if ! have pip3; then
      apk add --no-cache python3 py3-pip >>"$LOG" 2>&1 || { echo "[FAIL]   $name (pip3 missing)"; continue; }
    fi
    if pip install --quiet capstone pwntools >>"$LOG" 2>&1; then
      echo "[ok]     $name (capstone, pwntools)"
    else
      echo "[FAIL]   $name (pip; see $LOG)"
    fi
    continue
  fi
  echo "[install] $name"
  # shellcheck disable=SC2086
  if apk add --no-cache $pkgs >>"$LOG" 2>&1; then
    echo "[ok]     $name"
  else
    echo "[FAIL]   $name (see $LOG)"
  fi
done

# Summary
echo
echo "== summary =="
for c in git gcc g++ make cmake ninja python3 pip3 node npm objdump nasm gdb radare2 ltrace patchelf htop rsync ssh sqlite3 go cargo java; do
  if have "$c"; then
    v=$("$c" --version 2>/dev/null | head -1)
    printf '[ok]  %-10s %s\n' "$c" "${v:-installed}"
  fi
done
if have python3 && python3 -c 'import capstone' 2>/dev/null; then
  printf '[ok]  %-10s %s\n' "capstone" "$(python3 -c 'import capstone; print(capstone.__version__)' 2>/dev/null)"
fi
if python3 -c 'import pwn' 2>/dev/null; then
  printf '[ok]  %-10s %s\n' "pwntools" "installed"
fi
echo "== end =="
